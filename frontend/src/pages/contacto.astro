---
import Layout from '../layouts/Layout.astro';
import { getContactoSections } from '../lib/api/client';
import { generateSchemaGraph } from '../lib/seo/schema';
import ContactoHeroDoorsSection from '../components/sections/contacto/ContactoHeroDoorsSection.astro';
import ContactoFormSection from '../components/sections/contacto/ContactoFormSection.astro';
import ContactoChannelsSection from '../components/sections/contacto/ContactoChannelsSection.astro';

// Consumir datos normalizados desde WordPress REST API (con fallback tolerante a fallos)
const pageData = await getContactoSections();
const { seo, sections } = pageData;

// Generar esquema estructurado Schema.org JSON-LD (@graph)
const schemaGraph = generateSchemaGraph({
  url: seo.canonical_url || 'https://mitsachile.com/contacto/',
  title: seo.meta_title,
  description: seo.meta_description,
  image: seo.og_image,
  breadcrumbs: [
    { name: 'Inicio', url: 'https://mitsachile.com/' },
    { name: 'Contacto', url: 'https://mitsachile.com/contacto/' }
  ]
});
---

<Layout
  title={seo.meta_title}
  description={seo.meta_description}
  canonicalUrl={seo.canonical_url}
  image={seo.og_image}
  jsonLd={schemaGraph}
>
  <main id="main-content" class="contacto-page">
    {/* 1. Hero con las 4 Puertas de Acceso Especializadas */}
    <ContactoHeroDoorsSection hero={sections.hero} doors={sections.doors} />

    {/* 2. Formulario de Contacto Interactivo Adaptable */}
    <ContactoFormSection formData={sections.form} />

    {/* 3. Canales Directos, Casa Matriz y Cobertura Regional en 8 Países */}
    <ContactoChannelsSection channels={sections.channels} coverage={sections.coverage} />
  </main>
</Layout>

<style>
  .contacto-page {
    display: flex;
    flex-direction: column;
    width: 100%;
    min-height: 100vh;
  }
</style>
