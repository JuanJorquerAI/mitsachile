---
import Layout from '../layouts/Layout.astro';
import { getServiciosSections } from '../lib/api/client';
import { generateSchemaGraph } from '../lib/seo/schema';
import ServiciosHeroSection from '../components/sections/servicios/ServiciosHeroSection.astro';
import ServiciosMetricsSection from '../components/sections/servicios/ServiciosMetricsSection.astro';
import ServiciosGridSection from '../components/sections/servicios/ServiciosGridSection.astro';
import ServiciosProcessSection from '../components/sections/servicios/ServiciosProcessSection.astro';
import ServiciosCtaSection from '../components/sections/servicios/ServiciosCtaSection.astro';

// Consumir datos dinámicos desde WordPress REST API (con fallback tolerante a fallos)
const pageData = await getServiciosSections();
const { seo, sections } = pageData;

// Generar esquema estructurado Schema.org JSON-LD (@graph) para la página de servicios
const schemaGraph = generateSchemaGraph({
  url: seo.canonical_url || 'https://mitsachile.com/servicios/',
  title: seo.meta_title,
  description: seo.meta_description,
  image: seo.og_image,
  breadcrumbs: [
    { name: 'Inicio', url: 'https://mitsachile.com/' },
    { name: 'Servicios', url: 'https://mitsachile.com/servicios/' }
  ]
});
---

<Layout
  title={seo.meta_title}
  description={seo.meta_description}
  canonical={seo.canonical_url}
  ogImage={seo.og_image}
  schemaJson={schemaGraph}
  activeNav="servicios"
>
  <main id="main-content" class="servicios-page">
    {/* 1. Hero & Acciones Rápidas */}
    <ServiciosHeroSection data={sections.hero} />

    {/* 2. Métricas de Capacidad de Servicio */}
    <ServiciosMetricsSection metrics={sections.metrics} />

    {/* 3. Catálogo Modular de 6 Servicios */}
    <ServiciosGridSection services={sections.catalog} />

    {/* 4. Metodología de 4 Etapas de Asesoramiento (Brochure) */}
    <ServiciosProcessSection data={sections.process} />

    {/* 5. Llamado a la Acción para Proyectos y Repuestos */}
    <ServiciosCtaSection data={sections.cta} />
  </main>
</Layout>

<style>
  .servicios-page {
    display: flex;
    flex-direction: column;
    width: 100%;
    min-height: 100vh;
  }
</style>
