---
import Layout from '../../layouts/Layout.astro';
import { getArticles, type Article } from '../../lib/articles';
import { marked } from 'marked';

export async function getStaticPaths() {
  const articles = getArticles();
  return articles.map((article) => ({
    params: { slug: article.slug },
    props: { article },
  }));
}

interface Props {
  article: Article;
}

const { article } = Astro.props;

// Strip header metadata block from markdown content before rendering HTML
let cleanContent = article.rawMarkdown.replace(/^#\s+.+$/m, ''); // remove H1 (rendered in header)
cleanContent = cleanContent.replace(/Estado:\s+[^\n]+/g, '');
cleanContent = cleanContent.replace(/-\s+\*\*[^*]+:\*\*\s+[^\n]+/g, ''); // remove bullet metadata

const htmlContent = marked.parse(cleanContent);

const articleJsonLd = {
  "@context": "https://schema.org",
  "@type": "TechArticle",
  "headline": article.title,
  "description": article.description,
  "image": "https://mitsachile.com/images/recursos-img-2-92bb5d09.jpg",
  "author": {
    "@type": "Organization",
    "name": "Departamento de Ingeniería MITSA"
  },
  "publisher": {
    "@type": "Organization",
    "name": "MITSA SpA",
    "logo": {
      "@type": "ImageObject",
      "url": "https://mitsachile.com/images/mitsa-27703545.svg"
    }
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": `https://mitsachile.com/recursos/${article.slug}/`
  },
  "inLanguage": "es-CL"
};
---

<Layout
  title={article.seoTitle}
  description={article.description}
  type="article"
  jsonLd={articleJsonLd}
>
  <!-- Article Header -->
  <header style="background:#0D1B2A;color:#F8F6F0;padding:72px 40px 60px;position:relative;overflow:hidden">
    <div style="max-width:820px;margin:0 auto">
      <!-- Breadcrumb -->
      <nav style="font:500 12.5px 'Geist Mono',monospace;color:#8E9AA8;margin-bottom:20px;display:flex;align-items:center;gap:8px" aria-label="Miga de pan">
        <a href="/" style="color:#8E9AA8;text-decoration:none">Inicio</a>
        <span>/</span>
        <a href="/recursos/" style="color:#8E9AA8;text-decoration:none">Recursos</a>
        <span>/</span>
        <span style="color:#F8F6F0">{article.category}</span>
      </nav>

      <h1 style="font:700 clamp(30px,4.2vw,50px)/1.08 'Geist',sans-serif;letter-spacing:-.035em;color:#F8F6F0;margin:0 0 20px;text-wrap:pretty">
        {article.title}
      </h1>

      <div style="display:flex;align-items:center;gap:18px;font:500 13px 'Inter',sans-serif;color:#8E9AA8;flex-wrap:wrap">
        <span>Por Ingeniería MITSA</span>
        <span>·</span>
        <span>Revisión Técnica B2B</span>
        <span>·</span>
        <span style="background:rgba(248,246,240,0.1);padding:4px 12px;border-radius:999px;color:#F8F6F0;font-size:11.5px;font-family:'Geist Mono',monospace">
          {article.category}
        </span>
      </div>
    </div>
  </header>

  <!-- Article Body -->
  <article style="background:#F8F6F0;padding:64px 40px 96px">
    <div class="article-content" style="max-width:820px;margin:0 auto;background:#fff;border:1px solid #E0E1DD;border-radius:24px;padding:48px 44px;box-shadow:0 4px 25px rgba(0,0,0,0.02)">
      <div set:html={htmlContent} />
    </div>

    <!-- Author & Technical Assistance Callout -->
    <div style="max-width:820px;margin:40px auto 0;background:#0D1B2A;color:#F8F6F0;border-radius:20px;padding:36px 40px;display:grid;grid-template-columns:1.4fr 1fr;gap:32px;align-items:center" class="cta-article">
      <div>
        <div style="font:600 12px 'Geist Mono',monospace;letter-spacing:.12em;text-transform:uppercase;color:#8E9AA8;margin-bottom:8px">
          Soporte & Asesoría
        </div>
        <h3 style="font:700 22px 'Geist',sans-serif;color:#F8F6F0;margin:0 0 10px">
          ¿Dudas sobre cómo aplica esta normativa a su buque?
        </h3>
        <p style="font:400 14px/1.6 'Inter',sans-serif;color:rgba(248,246,240,0.7);margin:0">
          Nuestros ingenieros revisan planos, requerimientos OMI / DIRECTEMAR y memorias de cálculo sin costo de evaluación.
        </p>
      </div>
      <div style="text-align:right" class="cta-btn-wrap">
        <a href="/contacto/?tipo=evaluacion" style="background:#F8F6F0;color:#0D1B2A;padding:14px 26px;border-radius:999px;font:600 14px 'Geist',sans-serif;text-decoration:none;display:inline-block">
          Consultar a un especialista
        </a>
      </div>
    </div>
  </article>
</Layout>

<style is:global>
  .article-content {
    font-family: 'Inter', system-ui, sans-serif;
    color: #1B263B;
    line-height: 1.75;
    font-size: 15.5px;
  }
  .article-content h2 {
    font-family: 'Geist', sans-serif;
    font-size: clamp(22px, 2.5vw, 30px);
    font-weight: 700;
    letter-spacing: -0.03em;
    color: #0D1B2A;
    margin: 40px 0 16px;
    padding-top: 20px;
    border-top: 1px solid #EFEEE9;
  }
  .article-content h2:first-of-type {
    margin-top: 0;
    padding-top: 0;
    border-top: none;
  }
  .article-content h3 {
    font-family: 'Geist', sans-serif;
    font-size: 20px;
    font-weight: 600;
    color: #0D1B2A;
    margin: 28px 0 12px;
  }
  .article-content p {
    margin: 0 0 18px;
    color: #334E68;
  }
  .article-content blockquote {
    margin: 24px 0;
    padding: 20px 24px;
    background: #F8F6F0;
    border-left: 4px solid #0D1B2A;
    border-radius: 0 14px 14px 0;
    font-size: 15px;
    color: #0D1B2A;
  }
  .article-content blockquote p {
    margin: 0;
  }
  .article-content table {
    width: 100%;
    border-collapse: collapse;
    margin: 28px 0;
    font-size: 14px;
    border-radius: 12px;
    overflow: hidden;
  }
  .article-content th {
    background: #0D1B2A;
    color: #F8F6F0;
    font-family: 'Geist Mono', monospace;
    font-size: 11.5px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 12px 16px;
    text-align: left;
  }
  .article-content td {
    padding: 12px 16px;
    border-bottom: 1px solid #E0E1DD;
    background: #fff;
    color: #1B263B;
  }
  .article-content tr:nth-child(even) td {
    background: #FAFAF8;
  }
  .article-content ul, .article-content ol {
    margin: 0 0 20px;
    padding-left: 24px;
    color: #334E68;
  }
  .article-content li {
    margin-bottom: 8px;
  }
  .article-content a {
    color: #0D1B2A;
    text-decoration: underline;
    font-weight: 500;
  }

  @media (max-width: 750px) {
    .article-content {
      padding: 28px 20px !important;
    }
    .cta-article {
      grid-template-columns: 1fr !important;
      padding: 28px 22px !important;
    }
    .cta-btn-wrap {
      text-align: left !important;
    }
  }
</style>
