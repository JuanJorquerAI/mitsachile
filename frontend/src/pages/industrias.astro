---
import Layout from '../layouts/Layout.astro';
import { getIndustriasSections } from '../lib/api/client';
import { generateSchemaGraph } from '../lib/seo/schema';
import IndustriasHeroSection from '../components/sections/industrias/IndustriasHeroSection.astro';
import IndustriasGridSection from '../components/sections/industrias/IndustriasGridSection.astro';
import IndustriasCriteriaSection from '../components/sections/industrias/IndustriasCriteriaSection.astro';
import IndustriasCtaSection from '../components/sections/industrias/IndustriasCtaSection.astro';

// Consumir datos dinámicos desde WordPress REST API (con fallback estático tolerante a caídas)
const pageData = await getIndustriasSections();
const { seo, sections } = pageData;

// Generar esquema estructurado Schema.org JSON-LD (@graph)
const schemaGraph = generateSchemaGraph({
  url: seo.canonical_url || 'https://mitsachile.com/industrias/',
  title: seo.meta_title,
  description: seo.meta_description,
  image: seo.og_image,
  breadcrumbs: [
    { name: 'Inicio', url: 'https://mitsachile.com/' },
    { name: 'Industrias', url: 'https://mitsachile.com/industrias/' }
  ]
});
---

<Layout
  title={seo.meta_title}
  description={seo.meta_description}
  canonicalUrl={seo.canonical_url}
  image={seo.og_image}
  jsonLd={schemaGraph}
>
  <main id="main-content" class="industrias-page">
    {/* 1. Hero & Menú Rápido de Salto */}
    <IndustriasHeroSection hero={sections.hero} sectors={sections.industries} />

    {/* 2. Grid Especializado de 6 Sectores / Industrias */}
    <IndustriasGridSection industries={sections.industries} />

    {/* 3. Criterios de Selección e Ingeniería Técnica */}
    <IndustriasCriteriaSection data={sections.criteria} />

    {/* 4. Llamado a la Acción para Contactar a Ingeniería */}
    <IndustriasCtaSection data={sections.cta} />
  </main>
</Layout>

<style>
  .industrias-page {
    display: flex;
    flex-direction: column;
    width: 100%;
    min-height: 100vh;
  }
</style>
