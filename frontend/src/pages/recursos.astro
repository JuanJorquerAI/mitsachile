---
import Layout from '../layouts/Layout.astro';
import { getRecursosSections } from '../lib/api/client';
import { generateSchemaGraph } from '../lib/seo/schema';
import RecursosHeroSection from '../components/sections/recursos/RecursosHeroSection.astro';
import RecursosGatewaysSection from '../components/sections/recursos/RecursosGatewaysSection.astro';
import RecursosArticlesSection from '../components/sections/recursos/RecursosArticlesSection.astro';
import RecursosDownloadsSection from '../components/sections/recursos/RecursosDownloadsSection.astro';
import RecursosCtaSection from '../components/sections/recursos/RecursosCtaSection.astro';

// Consumir datos normalizados desde WordPress REST API (con fallback tolerante a fallos)
const pageData = await getRecursosSections();
const { seo, sections } = pageData;

// Generar esquema estructurado Schema.org JSON-LD (@graph)
const schemaGraph = generateSchemaGraph({
  url: seo.canonical_url || 'https://mitsachile.com/recursos/',
  title: seo.meta_title,
  description: seo.meta_description,
  image: seo.og_image,
  breadcrumbs: [
    { name: 'Inicio', url: 'https://mitsachile.com/' },
    { name: 'Recursos', url: 'https://mitsachile.com/recursos/' }
  ]
});
---

<Layout
  title={seo.meta_title}
  description={seo.meta_description}
  canonical={seo.canonical_url}
  ogImage={seo.og_image}
  schemaJson={schemaGraph}
  activeNav="recursos"
>
  <main id="main-content" class="recursos-page">
    {/* 1. Hero con H1 y accesos rápidos */}
    <RecursosHeroSection hero={sections.hero} />

    {/* 2. Portales de Acceso (Centro Técnico y Biblioteca) */}
    <RecursosGatewaysSection gateways={sections.gateways} />

    {/* 3. Cluster Regulatorio de Artículos Técnicos (Blog SEO) */}
    <RecursosArticlesSection articles={sections.articles} />

    {/* 4. Biblioteca Técnica Oficial de Descargas */}
    <RecursosDownloadsSection downloads={sections.downloads} />

    {/* 5. Llamado a la Acción para Documentación de Fábrica */}
    <RecursosCtaSection data={sections.cta} />
  </main>
</Layout>

<style>
  .recursos-page {
    display: flex;
    flex-direction: column;
    width: 100%;
    min-height: 100vh;
  }
</style>
