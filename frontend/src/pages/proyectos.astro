---
import Layout from '../layouts/Layout.astro';
import { getProyectosSections } from '../lib/api/client';
import { generateSchemaGraph } from '../lib/seo/schema';
import ProyectosHeroSection from '../components/sections/proyectos/ProyectosHeroSection.astro';
import ProyectosGridSection from '../components/sections/proyectos/ProyectosGridSection.astro';
import ProyectosMethodologySection from '../components/sections/proyectos/ProyectosMethodologySection.astro';
import ProyectosCtaSection from '../components/sections/proyectos/ProyectosCtaSection.astro';

// Consumir datos dinámicos desde WordPress REST API (con fallback tolerante a fallos)
const pageData = await getProyectosSections();
const { seo, sections } = pageData;

// Generar esquema estructurado Schema.org JSON-LD (@graph)
const schemaGraph = generateSchemaGraph({
  url: seo.canonical_url || 'https://mitsachile.com/proyectos/',
  title: seo.meta_title,
  description: seo.meta_description,
  image: seo.og_image,
  breadcrumbs: [
    { name: 'Inicio', url: 'https://mitsachile.com/' },
    { name: 'Proyectos', url: 'https://mitsachile.com/proyectos/' }
  ]
});
---

<Layout
  title={seo.meta_title}
  description={seo.meta_description}
  canonical={seo.canonical_url}
  ogImage={seo.og_image}
  schemaJson={schemaGraph}
  activeNav="proyectos"
>
  <main id="main-content" class="proyectos-page">
    {/* 1. Hero & Métricas de Respaldo */}
    <ProyectosHeroSection hero={sections.hero} metrics={sections.metrics} />

    {/* 2. Catálogo Interactivo de Casos y Proyectos por Sector */}
    <ProyectosGridSection projects={sections.projects} />

    {/* 3. Metodología de Ejecución de Ingeniería */}
    <ProyectosMethodologySection data={sections.methodology} />

    {/* 4. Llamado a la Acción para Referencias */}
    <ProyectosCtaSection data={sections.cta} />
  </main>
</Layout>

<style>
  .proyectos-page {
    display: flex;
    flex-direction: column;
    width: 100%;
    min-height: 100vh;
  }
</style>
