---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getSiteOptions } from '../lib/api/client';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonicalUrl?: string;
  type?: 'website' | 'article';
  jsonLd?: object;
  currentPath?: string;
}

const {
  title = "MITSA — Integramos tecnología. Resolvemos desafíos.",
  description = "Ingeniería de aplicación, suministro, retrofit, puesta en marcha y soporte. Cinco fabricantes representados, cuarenta años de proyectos en Chile y Latinoamérica.",
  image = "/images/plataforma-offshore-8886341c.jpg",
  canonicalUrl = Astro.url.href,
  type = "website",
  jsonLd,
  currentPath = Astro.url.pathname
} = Astro.props;

// Obtener opciones globales dinámicas (Marca, Header, Footer, Contacto, Redes)
const siteOptions = await getSiteOptions();
const { brand, header, footer, contact, social } = siteOptions;

const defaultJsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": "https://mitsachile.com/#organization",
      "name": "MITSA SpA",
      "url": "https://mitsachile.com",
      "logo": "https://mitsachile.com/images/mitsa-27703545.svg",
      "foundingDate": "1982",
      "description": "Soluciones de tratamiento de aguas, ingeniería sanitaria marina, protección de cascos y tecnologías ambientales para la industria marítima y terrestre.",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Viña del Mar",
        "addressRegion": "Valparaíso",
        "addressCountry": "CL"
      },
      "contactPoint": {
        "@type": "ContactPoint",
        "contactType": "Ventas y Soporte Técnico",
        "email": "contacto@mitsachile.com",
        "telephone": "+56-32-2835055"
      }
    },
    {
      "@type": "WebSite",
      "@id": "https://mitsachile.com/#website",
      "url": "https://mitsachile.com",
      "name": "MITSA",
      "publisher": { "@id": "https://mitsachile.com/#organization" }
    }
  ]
};
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalUrl} />
  
  <!-- Open Graph / Facebook -->
  <meta property="og:type" content={type} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={image} />
  
  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={image} />

  <!-- Preconnect Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&family=Inter:wght@400;500;600&family=Geist+Mono:wght@400;500&family=Instrument+Serif:ital@0;1&display=swap" rel="stylesheet" />

  <!-- Structured Data -->
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd || defaultJsonLd)} />

  <style is:global>
    * { box-sizing: border-box; }
    html, body {
      margin: 0;
      padding: 0;
      background: #F8F6F0;
      font-family: 'Inter', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      color: #1B263B;
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
    }
    a { color: inherit; text-decoration: none; }
    img { max-width: 100%; height: auto; display: block; }
    
    .site-container {
      max-width: 1180px;
      margin: 0 auto;
      background: #F8F6F0;
      overflow: hidden;
      box-shadow: 0 0 50px rgba(0,0,0,0.02);
    }

    @keyframes rotword {
      0%, 22% { opacity: 1; transform: translateY(0); }
      27%, 100% { opacity: 0; transform: translateY(-14px); }
    }

    .font-geist { font-family: 'Geist', sans-serif; }
    .font-inter { font-family: 'Inter', sans-serif; }
    .font-mono { font-family: 'Geist Mono', monospace; }
    .font-serif-italic { font-family: 'Instrument Serif', Georgia, serif; font-style: italic; }

    /* Utility scrollbar */
    ::-webkit-scrollbar { width: 8px; }
    ::-webkit-scrollbar-track { background: #F8F6F0; }
    ::-webkit-scrollbar-thumb { background: #E0E1DD; border-radius: 4px; }
    ::-webkit-scrollbar-thumb:hover { background: #8E9AA8; }
  </style>
</head>
<body>
  <div class="site-container">
    <Header currentPath={currentPath} brand={brand} header={header} />
    <main>
      <slot />
    </main>
    <Footer brand={brand} footer={footer} contact={contact} social={social} />
  </div>
</body>
</html>
