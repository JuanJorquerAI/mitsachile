---
import type { SiteBrandOptions, SiteHeaderOptions } from '../lib/api/types';

interface Props {
  currentPath?: string;
  brand?: SiteBrandOptions;
  header?: SiteHeaderOptions;
}

const {
  currentPath = Astro.url.pathname,
  brand = {
    name: 'MITSA',
    logo_main: '/images/mitsa-27703545.svg',
    tagline: 'Integramos tecnología. Resolvemos desafíos.',
  } as SiteBrandOptions,
  header = {
    btn_repuestos_label: 'Repuestos',
    btn_repuestos_url: '/contacto/?tipo=repuestos',
    btn_cta_label: 'Conversemos',
    btn_cta_url: '/contacto/',
  } as SiteHeaderOptions,
} = Astro.props;

const navItems = [
  { label: 'Inicio', href: '/' },
  { label: 'Nosotros', href: '/nosotros/' },
  { label: 'Representadas', href: '/representadas/' },
  { label: 'Industrias', href: '/industrias/' },
  { label: 'Servicios', href: '/servicios/' },
  { label: 'Proyectos', href: '/proyectos/' },
  { label: 'Recursos', href: '/recursos/' },
];

function isActive(href: string) {
  if (href === '/' && (currentPath === '/' || currentPath === '')) return true;
  if (href !== '/' && currentPath.startsWith(href)) return true;
  return false;
}
---

<header style="display:flex;align-items:center;justify-content:space-between;gap:16px;padding:18px 28px;background:#F8F6F0;position:sticky;top:0;z-index:50;backdrop-filter:blur(8px);border-bottom:1px solid rgba(224,225,221,0.6)">
  <!-- Logo Principal -->
  <a href="/" style="display:flex;align-items:center;text-decoration:none;flex-shrink:0" aria-label={`${brand.name} - Inicio`}>
    <img
      src={brand.logo_main || '/images/mitsa-27703545.svg'}
      alt={brand.name || 'MITSA'}
      style="height:38px;width:auto;display:block;aspect-ratio:120/38"
      width="120"
      height="38"
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />
  </a>

  <!-- Centered Navigation Pill -->
  <nav style="margin:0 auto;display:flex;gap:4px;background:#fff;border:1px solid #E0E1DD;border-radius:999px;padding:4px;font:500 13.5px 'Inter',sans-serif;color:#1B263B;box-shadow:0 2px 8px rgba(13,27,42,0.03)" aria-label="Navegación principal">
    {navItems.map((item) => {
      const active = isActive(item.href);
      return active ? (
        <span style="padding:8px 16px;border-radius:999px;background:#F1F0EC;color:#0D1B2A;font-weight:600">
          {item.label}
        </span>
      ) : (
        <a href={item.href} style="padding:8px 16px;color:inherit;text-decoration:none;border-radius:999px;transition:background 0.2s" class="nav-link">
          {item.label}
        </a>
      );
    })}
  </nav>

  <!-- Right Actions -->
  <div style="display:flex;align-items:center;gap:14px;flex-shrink:0">
    <a href={header.btn_repuestos_url || '/contacto/?tipo=repuestos'} style="font:500 13.5px 'Inter',sans-serif;color:#1B263B;text-decoration:none" class="nav-repuestos">
      {header.btn_repuestos_label || 'Repuestos'}
    </a>
    <a href={header.btn_cta_url || '/contacto/'} style="background:#0D1B2A;color:#F8F6F0;padding:11px 22px;border-radius:999px;font:600 13.5px 'Geist',sans-serif;text-decoration:none;transition:transform 0.15s, background 0.2s" class="btn-conversemos">
      {header.btn_cta_label || 'Conversemos'}
    </a>
  </div>
</header>

<style>
  .nav-link:hover {
    background: #F8F6F0;
    color: #0D1B2A;
  }

  .nav-repuestos:hover {
    color: #E63946;
  }

  .btn-conversemos:hover {
    background: #1B263B;
    transform: translateY(-1px);
  }

  .btn-conversemos:focus-visible,
  .nav-link:focus-visible,
  .nav-repuestos:focus-visible {
    outline: 2px solid #0D1B2A;
    outline-offset: 2px;
  }

  @media (max-width: 992px) {
    header {
      padding: 14px 18px !important;
    }
    nav {
      display: none !important;
    }
  }
</style>
