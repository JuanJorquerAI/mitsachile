---
import type { HeroSectionData } from '../../lib/api/types';

interface Props {
  data: HeroSectionData;
}

const { data } = Astro.props;
const {
  title_prefix = "Toda su ingeniería resuelta, del proyecto a la operación:",
  rotating_words = ["sanitaria", "de tratamiento", "de protección", "de agua dulce"],
  description = "Ingeniería de aplicación, suministro, retrofit, puesta en marcha y soporte. Cinco fabricantes representados de forma directa, cuarenta años de proyectos en Chile y Latinoamérica.",
  triage = {
    title: "¿Qué necesita resolver?",
    options: [
      { label: "Evaluación técnica", url: "/contacto/?tipo=evaluacion", highlight: true },
      { label: "Repuestos", url: "/contacto/?tipo=repuestos", highlight: false },
      { label: "Servicio técnico", url: "/contacto/?tipo=servicio", highlight: false }
    ],
    placeholder: "Describa su proyecto o nave...",
    button_text: "→",
    action_url: "/contacto/"
  }
} = data || {};
---

<section class="hero-section" aria-labelledby="hero-heading">
  <div class="hero-grid">
    <!-- Main Headline Column -->
    <div class="hero-content">
      <h1 id="hero-heading" class="hero-title">
        <span class="prefix">{title_prefix}</span>
        <span class="sr-only"> ({rotating_words.join(', ')})</span>
        <span class="rotator-container" aria-hidden="true">
          {rotating_words.map((word, index) => (
            <span
              class="rot-word"
              style={`animation-delay: ${index * 3}s;`}
            >
              {word}
            </span>
          ))}
        </span>
      </h1>
    </div>

    <!-- Triage & Description Column -->
    <div class="hero-actions">
      <p class="hero-desc">
        {description}
      </p>

      <!-- Triage Interactive Card -->
      <div class="triage-card" role="region" aria-label="Selector de necesidades del cliente">
        <div class="triage-title" id="triage-title">
          {triage.title}
        </div>

        <!-- Quick Access Filter Pills -->
        <div class="triage-pills" role="group" aria-labelledby="triage-title">
          {triage.options.map((opt) => (
            <a
              href={opt.url}
              class={`triage-pill ${opt.highlight ? 'pill-active' : 'pill-default'}`}
              aria-label={`Solicitar ${opt.label}`}
            >
              {opt.label}
            </a>
          ))}
        </div>

        <!-- Direct Query Search Form -->
        <form action={triage.action_url} method="GET" class="triage-form" role="search">
          <label for="hero-search-input" class="sr-only">Describa su proyecto o nave</label>
          <input
            id="hero-search-input"
            type="text"
            name="q"
            placeholder={triage.placeholder}
            class="triage-input"
            autocomplete="off"
          />
          <button
            type="submit"
            class="triage-submit"
            aria-label="Enviar consulta o buscar solución"
          >
            {triage.button_text}
          </button>
        </form>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-section {
    padding: 72px 40px 52px;
    background: transparent;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1.35fr 1fr;
    gap: 40px;
    align-items: start;
  }

  .hero-title {
    font-family: 'Geist', sans-serif;
    font-size: clamp(36px, 4.8vw, 64px);
    font-weight: 700;
    line-height: 1.04;
    letter-spacing: -0.04em;
    color: #0D1B2A;
    margin: 0;
    text-wrap: pretty;
  }

  .prefix {
    display: inline;
  }

  .rotator-container {
    position: relative;
    display: block;
    height: 1.08em;
    overflow: hidden;
    margin-top: 4px;
  }

  .rot-word {
    position: absolute;
    left: 0;
    top: 0;
    white-space: nowrap;
    color: #415A77;
    animation: rotword 12s infinite;
    opacity: 0;
  }

  .rot-word:first-child {
    opacity: 1;
  }

  @keyframes rotword {
    0%, 22% {
      opacity: 1;
      transform: translateY(0);
    }
    27%, 100% {
      opacity: 0;
      transform: translateY(-14px);
    }
  }

  .hero-desc {
    font-family: 'Inter', sans-serif;
    font-size: 15px;
    line-height: 1.6;
    color: #415A77;
    margin: 0 0 20px;
  }

  .triage-card {
    background: #FFFFFF;
    border: 1px solid #E0E1DD;
    border-radius: 20px;
    padding: 20px;
    box-shadow: 0 4px 20px rgba(13, 27, 42, 0.03);
  }

  .triage-title {
    font-family: 'Geist Mono', monospace;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #8E9AA8;
    margin-bottom: 12px;
  }

  .triage-pills {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin-bottom: 16px;
    font-family: 'Inter', sans-serif;
    font-size: 12.5px;
    font-weight: 500;
  }

  .triage-pill {
    padding: 7px 14px;
    border-radius: 999px;
    text-decoration: none;
    transition: all 0.2s ease;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 34px;
  }

  .pill-active {
    background: #0D1B2A;
    color: #F8F6F0;
  }

  .pill-active:hover, .pill-active:focus-visible {
    background: #1B263B;
    outline: 2px solid #0D1B2A;
    outline-offset: 2px;
  }

  .pill-default {
    border: 1px solid #E0E1DD;
    color: #1B263B;
    background: transparent;
  }

  .pill-default:hover, .pill-default:focus-visible {
    border-color: #0D1B2A;
    background: rgba(13, 27, 42, 0.04);
    outline: 2px solid #0D1B2A;
    outline-offset: 2px;
  }

  .triage-form {
    display: flex;
    gap: 8px;
  }

  .triage-input {
    flex: 1;
    height: 44px;
    border: 1px solid #E0E1DD;
    border-radius: 999px;
    background: #F8F6F0;
    padding: 0 18px;
    font-family: 'Inter', sans-serif;
    font-size: 13.5px;
    color: #0D1B2A;
    outline: none;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .triage-input:focus-visible {
    border-color: #0D1B2A;
    box-shadow: 0 0 0 2px rgba(13, 27, 42, 0.15);
  }

  .triage-submit {
    background: #0D1B2A;
    color: #F8F6F0;
    padding: 0 24px;
    min-height: 44px;
    min-width: 44px;
    border-radius: 999px;
    border: none;
    cursor: pointer;
    font-family: 'Geist', sans-serif;
    font-size: 15px;
    font-weight: 600;
    transition: background 0.2s ease, transform 0.1s ease;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .triage-submit:hover {
    background: #1B263B;
  }

  .triage-submit:focus-visible {
    outline: 2px solid #0D1B2A;
    outline-offset: 2px;
  }

  .triage-submit:active {
    transform: scale(0.97);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .rot-word {
      animation: none !important;
      position: static !important;
      opacity: 1 !important;
      display: inline-block;
      margin-right: 4px;
    }
    .rot-word:not(:last-child)::after {
      content: " · ";
      color: #8E9AA8;
    }
    .rotator-container {
      position: static;
      display: inline;
      height: auto;
      overflow: visible;
    }
    .triage-submit,
    .triage-pill,
    .triage-input {
      transition: none !important;
    }
  }

  @media (max-width: 900px) {
    .hero-grid {
      grid-template-columns: 1fr;
      gap: 32px;
    }

    .hero-section {
      padding: 48px 20px 36px;
    }
  }
</style>
