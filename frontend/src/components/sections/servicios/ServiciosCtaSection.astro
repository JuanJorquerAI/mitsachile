---
import type { ServiciosCtaData } from '../../../lib/api/types';

interface Props {
  data: ServiciosCtaData;
}

const { data } = Astro.props;
const {
  heading = "¿Tiene un proyecto naval o industrial en curso?",
  description = "Revise requerimientos de caudal, espacio y plazos de entrega directamente con nuestros ingenieros de aplicación.",
  primary_button = {
    label: "Solicitar evaluación técnica",
    url: "/contacto/?tipo=evaluacion"
  },
  secondary_button = {
    label: "Consultar repuestos",
    url: "/contacto/?tipo=repuestos"
  }
} = data || {};
---

<section class="servicios-cta" aria-labelledby="servicios-cta-heading">
  <div class="cta-container">
    <div class="cta-box">
      <h2 id="servicios-cta-heading" class="cta-title">{heading}</h2>
      <p class="cta-desc">{description}</p>
      
      <div class="cta-actions">
        <a href={primary_button.url} class="btn-primary">
          {primary_button.label}
          <span aria-hidden="true">→</span>
        </a>
        <a href={secondary_button.url} class="btn-secondary">
          {secondary_button.label}
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .servicios-cta {
    background: #F8FAFC;
    padding: 80px 24px;
  }

  .cta-container {
    max-width: 1000px;
    margin: 0 auto;
  }

  .cta-box {
    background: #0D1B2A;
    border-radius: 16px;
    padding: 56px 48px;
    text-align: center;
    box-shadow: 0 12px 36px rgba(13, 27, 42, 0.12);
  }

  .cta-title {
    font-size: clamp(1.75rem, 3.5vw, 2.375rem);
    font-weight: 800;
    color: #FFFFFF;
    letter-spacing: -0.02em;
    margin: 0 0 16px;
    line-height: 1.25;
  }

  .cta-desc {
    font-size: 1.125rem;
    line-height: 1.6;
    color: #CBD5E1;
    margin: 0 auto 36px;
    max-width: 60ch;
  }

  .cta-actions {
    display: flex;
    justify-content: center;
    gap: 16px;
    flex-wrap: wrap;
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #E63946;
    color: #FFFFFF;
    font-size: 1rem;
    font-weight: 700;
    padding: 14px 28px;
    border-radius: 8px;
    text-decoration: none;
    min-height: 48px;
    box-sizing: border-box;
    transition: background-color 0.2s ease, transform 0.15s ease;
    box-shadow: 0 4px 16px rgba(230, 57, 70, 0.3);
  }

  .btn-primary:hover {
    background: #D62839;
    transform: translateY(-2px);
  }

  .btn-primary:focus-visible {
    outline: 3px solid #FFFFFF;
    outline-offset: 3px;
  }

  .btn-secondary {
    display: inline-flex;
    align-items: center;
    background: transparent;
    border: 1px solid rgba(255, 255, 255, 0.3);
    color: #FFFFFF;
    font-size: 1rem;
    font-weight: 600;
    padding: 14px 28px;
    border-radius: 8px;
    text-decoration: none;
    min-height: 48px;
    box-sizing: border-box;
    transition: background-color 0.2s ease, border-color 0.2s ease;
  }

  .btn-secondary:hover {
    background: rgba(255, 255, 255, 0.1);
    border-color: #FFFFFF;
  }

  .btn-secondary:focus-visible {
    outline: 3px solid #FFFFFF;
    outline-offset: 3px;
  }

  @media (max-width: 600px) {
    .servicios-cta {
      padding: 48px 16px;
    }
    .cta-box {
      padding: 36px 24px;
    }
    .cta-actions {
      flex-direction: column;
    }
    .btn-primary, .btn-secondary {
      width: 100%;
      justify-content: center;
    }
  }
</style>
