---
import type { IndustriasCriteriaData } from '../../../lib/api/types';

interface Props {
  data: IndustriasCriteriaData;
}

const { data } = Astro.props;
const {
  heading = "Criterios de ingeniería por industria",
  subheading = "Variables críticas de diseño que evalúan nuestros ingenieros de aplicación para cada tipo de instalación.",
  items = [
    {
      title: "Normativa y Certificaciones de Clase",
      description: "Cumplimiento estricto con IMO MARPOL (Anexo IV y D-2), SOLAS, USCG y casas clasificadoras (DNV, Lloyd's Register, ABS)."
    },
    {
      title: "Ventanas de Intervención en Faena",
      description: "Coordinación con recaladas acotadas, diques secos y paradas de planta programadas para evitar sobrecostos por detención."
    },
    {
      title: "Redundancia y Continuidad Operativa",
      description: "Diseño con bombas duplicadas, módulos en standby y repuestos críticos garantizados por el fabricante."
    },
    {
      title: "Eficiencia Hídrica y Energética",
      description: "Reducción de consumo de agua hasta un 90% mediante sistemas al vacío e intercambiadores térmicos de alta eficiencia."
    }
  ]
} = data || {};
---

<section class="criteria-section" aria-labelledby="criteria-heading">
  <div class="criteria-container">
    <div class="section-intro">
      <span class="badge-sub">Criterios de Diseño</span>
      <h2 id="criteria-heading" class="section-title">{heading}</h2>
      <p class="section-subtitle">{subheading}</p>
    </div>

    <div class="criteria-grid">
      {items.map((crit, index) => (
        <article class="criterion-card">
          <div class="criterion-num">0{index + 1}</div>
          <h3 class="criterion-title">{crit.title}</h3>
          <p class="criterion-desc">{crit.description}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .criteria-section {
    background: #0D1B2A;
    color: #F8F6F0;
    padding: 88px 24px;
    border-bottom: 1px solid rgba(248, 246, 240, 0.08);
  }

  .criteria-container {
    max-width: 1200px;
    margin: 0 auto;
  }

  .section-intro {
    max-width: 760px;
    margin-bottom: 56px;
  }

  .badge-sub {
    font-size: 0.8125rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #E63946;
    background: rgba(230, 57, 70, 0.12);
    padding: 6px 14px;
    border-radius: 999px;
    display: inline-block;
    margin-bottom: 16px;
    border: 1px solid rgba(230, 57, 70, 0.25);
  }

  .section-title {
    font-size: clamp(1.75rem, 3.5vw, 2.5rem);
    font-weight: 800;
    color: #FFFFFF;
    letter-spacing: -0.02em;
    margin: 0 0 16px;
    line-height: 1.2;
  }

  .section-subtitle {
    font-size: 1.0625rem;
    color: #94A3B8;
    line-height: 1.6;
    margin: 0;
  }

  .criteria-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
  }

  .criterion-card {
    background: #1B263B;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 14px;
    padding: 32px 24px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    transition: transform 0.2s ease, border-color 0.2s ease, background 0.2s ease;
  }

  .criterion-card:hover {
    transform: translateY(-4px);
    border-color: rgba(230, 57, 70, 0.4);
    background: #233148;
  }

  .criterion-num {
    font-family: monospace;
    font-size: 1.25rem;
    font-weight: 800;
    color: #E63946;
  }

  .criterion-title {
    font-size: 1.1875rem;
    font-weight: 700;
    color: #FFFFFF;
    margin: 0;
    line-height: 1.35;
  }

  .criterion-desc {
    font-size: 0.9375rem;
    line-height: 1.6;
    color: #CBD5E1;
    margin: 0;
  }

  @media (max-width: 1024px) {
    .criteria-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 24px;
    }
  }

  @media (max-width: 600px) {
    .criteria-grid {
      grid-template-columns: 1fr;
    }
    .criteria-section {
      padding: 56px 16px;
    }
  }
</style>
