---
interface ArticleItem {
  slug: string;
  title: string;
  description: string;
  category: string;
  readTime: string;
}

interface Props {
  articles?: ArticleItem[];
  heading?: string;
  eyebrow?: string;
}

const {
  articles = [],
  heading = "Guías y análisis de ingeniería aplicada",
  eyebrow = "Biblioteca Técnica & Normativa"
} = Astro.props;
---

<section class="articles-section" id="recursos" aria-labelledby="articles-heading">
  <div class="articles-header">
    <div>
      <div class="articles-eyebrow">{eyebrow}</div>
      <h2 id="articles-heading" class="articles-title">
        {heading}
      </h2>
    </div>
    <a href="/recursos/" class="all-articles-link">
      Ver todos los artículos <span aria-hidden="true">→</span>
    </a>
  </div>

  <div class="articles-grid">
    {articles.slice(0, 3).map((art) => (
      <article class="article-card">
        <div class="article-body">
          <div>
            <div class="article-meta">
              {art.category} · {art.readTime}
            </div>
            <h3 class="article-card-title">
              <a href={`/recursos/${art.slug}/`} class="article-title-link">
                {art.title}
              </a>
            </h3>
            <p class="article-desc">{art.description}</p>
          </div>
          <div class="article-footer">
            <a href={`/recursos/${art.slug}/`} class="read-more-link" aria-label={`Leer análisis completo sobre ${art.title}`}>
              Leer análisis completo <span aria-hidden="true">→</span>
            </a>
          </div>
        </div>
      </article>
    ))}
  </div>
</section>

<style>
  .articles-section {
    background: #F8F6F0;
    padding: 96px 40px;
  }

  .articles-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 34px;
    gap: 20px;
    flex-wrap: wrap;
  }

  .articles-eyebrow {
    font-family: 'Geist Mono', monospace;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #8E9AA8;
    margin-bottom: 8px;
  }

  .articles-title {
    font-family: 'Geist', sans-serif;
    font-size: clamp(28px, 3.4vw, 44px);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.04em;
    color: #0D1B2A;
    margin: 0;
    text-wrap: pretty;
  }

  .all-articles-link {
    font-family: 'Geist', sans-serif;
    font-size: 13px;
    font-weight: 600;
    color: #0D1B2A;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }

  .all-articles-link:hover, .all-articles-link:focus-visible {
    color: #415A77;
    text-decoration: underline;
    outline: none;
  }

  .articles-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
  }

  .article-card {
    background: #FFFFFF;
    border: 1px solid #E0E1DD;
    border-radius: 20px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .article-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 12px 30px rgba(13, 27, 42, 0.06);
  }

  .article-body {
    padding: 24px;
    display: flex;
    flex-direction: column;
    flex: 1;
    justify-content: space-between;
  }

  .article-meta {
    font-family: 'Geist Mono', monospace;
    font-size: 11.5px;
    color: #8E9AA8;
    margin-bottom: 8px;
  }

  .article-card-title {
    font-family: 'Geist', sans-serif;
    font-size: 18px;
    line-height: 1.3;
    font-weight: 600;
    color: #0D1B2A;
    margin: 0 0 10px;
    letter-spacing: -0.02em;
  }

  .article-title-link {
    color: inherit;
    text-decoration: none;
  }

  .article-title-link:hover, .article-title-link:focus-visible {
    color: #415A77;
    outline: none;
  }

  .article-desc {
    font-family: 'Inter', sans-serif;
    font-size: 13px;
    line-height: 1.5;
    color: #415A77;
    margin: 0;
  }

  .article-footer {
    margin-top: 20px;
    padding-top: 14px;
    border-top: 1px solid #F0EFEA;
  }

  .read-more-link {
    font-family: 'Geist', sans-serif;
    font-size: 12.5px;
    font-weight: 600;
    color: #0D1B2A;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }

  .read-more-link:hover, .read-more-link:focus-visible {
    color: #415A77;
    text-decoration: underline;
    outline: none;
  }

  @media (max-width: 900px) {
    .articles-section {
      padding: 64px 20px;
    }
    .articles-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
