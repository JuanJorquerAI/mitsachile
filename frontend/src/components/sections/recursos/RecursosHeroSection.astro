---
import type { RecursosHeroData } from '../../../lib/api/types';

interface Props {
  hero: RecursosHeroData;
}

const { hero } = Astro.props;
const {
  title = "El criterio técnico, publicado.",
  description = "Artículos abiertos sobre normativa marítima, documentación técnica de representadas y protocolos de ingeniería para clientes.",
  image = "/images/recursos-img-2-92bb5d09.jpg",
  primary_button = {
    label: "Ver artículos técnicos",
    url: "#articulos"
  },
  secondary_button = {
    label: "Biblioteca de descargas",
    url: "#biblioteca"
  }
} = hero || {};
---

<section class="recursos-hero" aria-labelledby="recursos-hero-heading">
  <div class="hero-bg-grid" aria-hidden="true"></div>
  <div class="hero-container">
    <div class="hero-text">
      <div class="hero-badge-wrap">
        <span class="badge-line" aria-hidden="true"></span>
        <span class="badge-label">Conocimiento & Descargas</span>
      </div>
      <h1 id="recursos-hero-heading" class="hero-title">{title}</h1>
      <p class="hero-desc">{description}</p>
      
      <div class="hero-actions">
        <a href={primary_button.url} class="btn-primary">
          {primary_button.label}
          <span aria-hidden="true">↓</span>
        </a>
        <a href={secondary_button.url} class="btn-secondary">
          {secondary_button.label}
          <span aria-hidden="true">↓</span>
        </a>
      </div>
    </div>

    <div class="hero-media">
      <img
        src={image || "/images/recursos-img-2-92bb5d09.jpg"}
        alt="Biblioteca técnica e ingeniería naval MITSA"
        width="600"
        height="400"
        loading="eager"
        fetchpriority="high"
        decoding="async"
        class="hero-img"
      />
    </div>
  </div>
</section>

<style>
  .recursos-hero {
    position: relative;
    background: #0D1B2A;
    color: #F8F6F0;
    overflow: hidden;
    padding: 80px 24px;
    border-bottom: 1px solid rgba(248, 246, 240, 0.08);
  }

  .hero-bg-grid {
    position: absolute;
    inset: 0;
    background-image: linear-gradient(rgba(65, 90, 119, 0.15) 1px, transparent 1px),
                      linear-gradient(90deg, rgba(65, 90, 119, 0.15) 1px, transparent 1px);
    background-size: 80px 80px;
    pointer-events: none;
  }

  .hero-container {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 56px;
    align-items: center;
    position: relative;
    z-index: 2;
  }

  .hero-badge-wrap {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 20px;
  }

  .badge-line {
    width: 36px;
    height: 2px;
    background: #E63946;
  }

  .badge-label {
    font-family: monospace;
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: #E0E1DD;
  }

  .hero-title {
    font-size: clamp(2.25rem, 4.5vw, 3.625rem);
    font-weight: 800;
    line-height: 1.12;
    letter-spacing: -0.035em;
    color: #FFFFFF;
    margin: 0 0 20px;
  }

  .hero-desc {
    font-size: 1.125rem;
    line-height: 1.65;
    color: #CBD5E1;
    margin: 0 0 32px;
    max-width: 52ch;
  }

  .hero-actions {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #E63946;
    color: #FFFFFF;
    padding: 13px 26px;
    border-radius: 999px;
    font-size: 0.9375rem;
    font-weight: 700;
    text-decoration: none;
    min-height: 48px;
    box-sizing: border-box;
    transition: background-color 0.2s ease, transform 0.15s ease;
  }

  .btn-primary:hover {
    background: #D62839;
    transform: translateY(-2px);
  }

  .btn-primary:focus-visible {
    outline: 3px solid #FFFFFF;
    outline-offset: 3px;
  }

  .btn-secondary {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: transparent;
    border: 1px solid rgba(224, 225, 221, 0.4);
    color: #F8F6F0;
    padding: 13px 26px;
    border-radius: 999px;
    font-size: 0.9375rem;
    font-weight: 600;
    text-decoration: none;
    min-height: 48px;
    box-sizing: border-box;
    transition: background-color 0.2s ease, border-color 0.2s ease;
  }

  .btn-secondary:hover {
    background: rgba(255, 255, 255, 0.08);
    border-color: #FFFFFF;
  }

  .btn-secondary:focus-visible {
    outline: 3px solid #FFFFFF;
    outline-offset: 3px;
  }

  .hero-media {
    position: relative;
    border-radius: 16px;
    overflow: hidden;
    height: 380px;
    border: 1px solid rgba(255, 255, 255, 0.15);
    box-shadow: 0 20px 48px rgba(0, 0, 0, 0.4);
  }

  .hero-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  @media (max-width: 900px) {
    .recursos-hero {
      padding: 56px 16px;
    }
    .hero-container {
      grid-template-columns: 1fr;
      gap: 36px;
    }
  }
</style>
