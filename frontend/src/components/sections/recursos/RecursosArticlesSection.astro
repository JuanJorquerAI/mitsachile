---
import type { RecursosArticleItemData } from '../../../lib/api/types';

interface Props {
  articles: RecursosArticleItemData[];
}

const { articles = [] } = Astro.props;
---

<section class="recursos-articles-section" id="articulos" aria-labelledby="articles-heading">
  <div class="articles-container">
    <div class="section-header">
      <div>
        <span class="badge-sub">Cluster Regulatorio & Normativo</span>
        <h2 id="articles-heading" class="section-title">Artículos Técnicos Especializados</h2>
        <p class="section-subtitle">
          Criterio de ingeniería naval y análisis de normativas OMI, DIRECTEMAR y MARPOL para naves en Chile.
        </p>
      </div>
    </div>

    <div class="articles-grid">
      {articles.map((art) => (
        <article class="article-card">
          <div class="card-meta">
            <span class="category-tag">{art.category}</span>
            <span class="status-tag">GUÍA TÉCNICA</span>
          </div>

          <h3 class="card-title">
            <a href={`/recursos/${art.slug}/`} class="title-link">
              {art.title}
            </a>
          </h3>

          <p class="card-desc">{art.description}</p>

          <div class="card-footer">
            <a href={`/recursos/${art.slug}/`} class="read-link">
              Leer artículo completo
              <span aria-hidden="true">→</span>
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .recursos-articles-section {
    background: #F8FAFC;
    padding: 72px 24px;
    border-bottom: 1px solid #E2E8F0;
    scroll-margin-top: 80px;
  }

  .articles-container {
    max-width: 1200px;
    margin: 0 auto;
  }

  .section-header {
    margin-bottom: 48px;
    padding-bottom: 24px;
    border-bottom: 1px solid #E2E8F0;
  }

  .badge-sub {
    font-size: 0.8125rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #1B263B;
    background: #E2E8F0;
    padding: 6px 14px;
    border-radius: 999px;
    display: inline-block;
    margin-bottom: 14px;
  }

  .section-title {
    font-size: clamp(1.75rem, 3.5vw, 2.5rem);
    font-weight: 800;
    color: #0D1B2A;
    letter-spacing: -0.02em;
    margin: 0 0 12px;
    line-height: 1.2;
  }

  .section-subtitle {
    font-size: 1.0625rem;
    color: #64748B;
    line-height: 1.6;
    margin: 0;
    max-width: 60ch;
  }

  .articles-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 28px;
  }

  .article-card {
    background: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 16px;
    padding: 28px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
  }

  .article-card:hover {
    transform: translateY(-4px);
    border-color: #CBD5E1;
    box-shadow: 0 12px 32px rgba(13, 27, 42, 0.06);
  }

  .card-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 8px;
    margin-bottom: 16px;
  }

  .category-tag {
    font-family: monospace;
    font-size: 0.75rem;
    font-weight: 700;
    color: #415A77;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .status-tag {
    font-family: monospace;
    font-size: 0.6875rem;
    font-weight: 700;
    color: #94A3B8;
    letter-spacing: 0.1em;
  }

  .card-title {
    font-size: 1.1875rem;
    font-weight: 700;
    color: #0D1B2A;
    line-height: 1.35;
    margin: 0 0 14px;
    letter-spacing: -0.01em;
  }

  .title-link {
    color: inherit;
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .title-link:hover {
    color: #E63946;
  }

  .card-desc {
    font-size: 0.9375rem;
    line-height: 1.6;
    color: #475569;
    margin: 0 0 24px;
    flex-grow: 1;
  }

  .card-footer {
    border-top: 1px solid #F1F5F9;
    padding-top: 16px;
  }

  .read-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.875rem;
    font-weight: 700;
    color: #E63946;
    text-decoration: none;
    transition: transform 0.15s ease, color 0.15s ease;
  }

  .read-link:hover {
    color: #D62839;
    transform: translateX(3px);
  }

  @media (max-width: 1024px) {
    .articles-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .articles-grid {
      grid-template-columns: 1fr;
    }
    .recursos-articles-section {
      padding: 48px 16px;
    }
  }
</style>
