---
import type { RecursosDownloadItemData } from '../../../lib/api/types';

interface Props {
  downloads: RecursosDownloadItemData[];
}

const { downloads = [] } = Astro.props;
---

<section class="recursos-downloads-section" id="biblioteca" aria-labelledby="downloads-heading">
  <div class="downloads-container">
    <div class="section-header">
      <div>
        <span class="badge-sub">Centro de Descargas</span>
        <h2 id="downloads-heading" class="section-title">Biblioteca Técnica Oficial</h2>
        <p class="section-subtitle">
          Catálogos de representadas, manuales de servicio, fichas de homologación y protocolos de comisionamiento.
        </p>
      </div>
    </div>

    <div class="downloads-list" role="list">
      {downloads.map((doc) => (
        <div class="download-item" role="listitem">
          <div class="doc-icon" aria-hidden="true">
            📄
          </div>

          <div class="doc-info">
            <h3 class="doc-title">{doc.title}</h3>
            <div class="doc-meta">
              <span class="doc-format">{doc.format}</span>
              <span class={`doc-level ${doc.level.includes('Libre') ? 'level-free' : 'level-restricted'}`}>
                {doc.level}
              </span>
            </div>
          </div>

          <div class="doc-action">
            <a href={doc.url} class="btn-download">
              Descargar / Solicitar
              <span aria-hidden="true">↓</span>
            </a>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .recursos-downloads-section {
    background: #FFFFFF;
    padding: 80px 24px;
    border-bottom: 1px solid #E2E8F0;
    scroll-margin-top: 80px;
  }

  .downloads-container {
    max-width: 1200px;
    margin: 0 auto;
  }

  .section-header {
    margin-bottom: 40px;
    padding-bottom: 24px;
    border-bottom: 1px solid #E2E8F0;
  }

  .badge-sub {
    font-size: 0.8125rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #E63946;
    background: rgba(230, 57, 70, 0.08);
    padding: 6px 14px;
    border-radius: 999px;
    display: inline-block;
    margin-bottom: 14px;
  }

  .section-title {
    font-size: clamp(1.75rem, 3.5vw, 2.5rem);
    font-weight: 800;
    color: #0D1B2A;
    letter-spacing: -0.02em;
    margin: 0 0 12px;
    line-height: 1.2;
  }

  .section-subtitle {
    font-size: 1.0625rem;
    color: #64748B;
    line-height: 1.6;
    margin: 0;
  }

  .downloads-list {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .download-item {
    background: #F8FAFC;
    border: 1px solid #E2E8F0;
    border-radius: 12px;
    padding: 20px 24px;
    display: flex;
    align-items: center;
    gap: 20px;
    transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .download-item:hover {
    transform: translateY(-2px);
    border-color: #CBD5E1;
    background: #FFFFFF;
    box-shadow: 0 8px 24px rgba(13, 27, 42, 0.05);
  }

  .doc-icon {
    font-size: 1.75rem;
    width: 48px;
    height: 48px;
    background: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .doc-info {
    flex-grow: 1;
  }

  .doc-title {
    font-size: 1.0625rem;
    font-weight: 700;
    color: #0D1B2A;
    margin: 0 0 6px;
    line-height: 1.35;
  }

  .doc-meta {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
  }

  .doc-format {
    font-family: monospace;
    font-size: 0.8125rem;
    color: #64748B;
  }

  .doc-level {
    font-size: 0.75rem;
    font-weight: 700;
    padding: 2px 8px;
    border-radius: 4px;
  }

  .level-free {
    background: #DCFCE7;
    color: #166534;
  }

  .level-restricted {
    background: #FEF3C7;
    color: #92400E;
  }

  .btn-download {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: #0D1B2A;
    color: #FFFFFF;
    font-size: 0.875rem;
    font-weight: 700;
    padding: 10px 18px;
    border-radius: 8px;
    text-decoration: none;
    white-space: nowrap;
    transition: background-color 0.2s ease;
  }

  .btn-download:hover {
    background: #1B263B;
  }

  .btn-download:focus-visible {
    outline: 2px solid #E63946;
    outline-offset: 2px;
  }

  @media (max-width: 768px) {
    .download-item {
      flex-direction: column;
      align-items: flex-start;
      gap: 16px;
    }
    .btn-download {
      width: 100%;
      justify-content: center;
    }
  }
</style>
