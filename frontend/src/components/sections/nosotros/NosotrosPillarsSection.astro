---
import type { NosotrosPillarsData } from '../../../lib/api/types';

interface Props {
  data: NosotrosPillarsData;
}

const { data } = Astro.props;
const {
  heading = "Los pilares que fundamentan nuestra propuesta",
  items = [
    { title: "Representación Oficial Directa", description: "Vínculo directo sin intermediarios con fabricantes líderes mundiales e inventores de la tecnología." },
    { title: "Ingeniería de Aplicación Propia", description: "Dimensionamiento a medida, selección de materiales y cumplimiento estricto de normativas internacionales." },
    { title: "Servicio Técnico en Terreno", description: "Ingenieros especialistas para puesta en marcha, pruebas de mar, mantenciones y capacitación." },
    { title: "Cuidado del Medio Ambiente Acuático", description: "Tecnologías certificadas bajo normas OMI MARPOL Anexo IV y D-2 para cero impacto ambiental." }
  ]
} = data || {};
---

<section class="pillars-section" aria-labelledby="pillars-heading">
  <div class="pillars-container">
    <div class="section-header">
      <span class="badge-sub">Diferenciación Técnica</span>
      <h2 id="pillars-heading" class="section-title">{heading}</h2>
      <p class="section-subtitle">
        Capacidades operativas y comerciales que garantizan continuidad y respaldo a lo largo del ciclo de vida del equipo.
      </p>
    </div>

    <div class="pillars-grid">
      {items.map((pillar, index) => (
        <article class="pillar-card">
          <div class="pillar-number">0{index + 1}</div>
          <h3 class="pillar-title">{pillar.title}</h3>
          <p class="pillar-desc">{pillar.description}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .pillars-section {
    background: #0D1B2A;
    color: #F8F6F0;
    padding: 88px 24px;
    border-bottom: 1px solid rgba(248, 246, 240, 0.08);
  }

  .pillars-container {
    max-width: 1200px;
    margin: 0 auto;
  }

  .section-header {
    max-width: 760px;
    margin-bottom: 56px;
  }

  .badge-sub {
    font-size: 0.8125rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #E63946;
    background: rgba(230, 57, 70, 0.12);
    padding: 6px 14px;
    border-radius: 999px;
    display: inline-block;
    margin-bottom: 16px;
  }

  .section-title {
    font-size: clamp(1.75rem, 3.5vw, 2.5rem);
    font-weight: 800;
    color: #FFFFFF;
    letter-spacing: -0.02em;
    margin: 0 0 16px;
    line-height: 1.2;
  }

  .section-subtitle {
    font-size: 1.0625rem;
    color: #94A3B8;
    line-height: 1.6;
    margin: 0;
  }

  .pillars-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
  }

  .pillar-card {
    background: #1B263B;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 14px;
    padding: 32px 24px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    transition: transform 0.2s ease, border-color 0.2s ease, background-color 0.2s ease;
  }

  .pillar-card:hover {
    transform: translateY(-4px);
    border-color: rgba(230, 57, 70, 0.4);
    background: #233148;
  }

  .pillar-number {
    font-size: 1.25rem;
    font-weight: 800;
    color: #E63946;
    font-family: monospace;
  }

  .pillar-title {
    font-size: 1.1875rem;
    font-weight: 700;
    color: #FFFFFF;
    margin: 0;
    line-height: 1.35;
  }

  .pillar-desc {
    font-size: 0.9375rem;
    line-height: 1.6;
    color: #CBD5E1;
    margin: 0;
  }

  @media (max-width: 1024px) {
    .pillars-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 24px;
    }
  }

  @media (max-width: 600px) {
    .pillars-grid {
      grid-template-columns: 1fr;
    }
    .pillars-section {
      padding: 56px 16px;
    }
  }
</style>
