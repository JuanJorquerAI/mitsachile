---
import type { NosotrosStoryData } from '../../../lib/api/types';

interface Props {
  data: NosotrosStoryData;
}

const { data } = Astro.props;
const {
  title = "Pioneros en tecnología marina y ambiental desde 1982",
  paragraphs = [
    "Fundada en 1982 en Reñaca, Viña del Mar, MITSA nació con la convicción de conectar a las industrias marítimas y productivas de Chile con los inventores y fabricantes de tecnología de mayor estándar mundial.",
    "A lo largo de más de cuatro décadas, hemos evolucionado de la provisión de equipos sanitarios al vacío hacia la ingeniería de aplicación integral, comisionamiento y respaldo operativo en terreno en todo el país."
  ],
  milestones = [
    { year: "1982", title: "Fundación en Reñaca, Viña del Mar", description: "Inicio de operaciones representando tecnología pionera sanitaria marina." },
    { year: "1995", title: "Expansión a Flotas y Astilleros", description: "Consolidación en buques de la Armada de Chile, marina mercante y salmonicultura." },
    { year: "2010", title: "Alianzas Globales de Fabricación", description: "Representación directa y exclusiva de EVAC, Cathelco, ERMA FIRST, EPE y BLÜCHER." },
    { year: "2026", title: "Ingeniería y Presencia Regional", description: "Proyectos de retrofit, BWTS D-2, protección ICCP y servicios en Chile y Latinoamérica." }
  ]
} = data || {};
---

<section class="timeline-section" aria-labelledby="timeline-heading">
  <div class="timeline-container">
    <div class="timeline-header">
      <span class="badge-sub">Evolución Histórica</span>
      <h2 id="timeline-heading" class="timeline-title">{title}</h2>
      <div class="intro-paragraphs">
        {paragraphs.map((p) => (
          <p class="story-p">{p}</p>
        ))}
      </div>
    </div>

    <div class="timeline-track">
      <div class="timeline-line" aria-hidden="true"></div>
      <div class="milestones-grid">
        {milestones.map((m, index) => (
          <article class="milestone-card" data-index={index}>
            <div class="milestone-badge">
              <span class="year">{m.year}</span>
              <span class="dot" aria-hidden="true"></span>
            </div>
            <div class="milestone-body">
              <h3 class="milestone-title">{m.title}</h3>
              <p class="milestone-desc">{m.description}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .timeline-section {
    background: #FFFFFF;
    padding: 88px 24px;
    border-bottom: 1px solid #E2E8F0;
  }

  .timeline-container {
    max-width: 1200px;
    margin: 0 auto;
  }

  .timeline-header {
    max-width: 820px;
    margin-bottom: 64px;
  }

  .badge-sub {
    font-size: 0.8125rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #1B263B;
    background: #F1F5F9;
    padding: 6px 14px;
    border-radius: 999px;
    display: inline-block;
    margin-bottom: 16px;
  }

  .timeline-title {
    font-size: clamp(1.75rem, 3.5vw, 2.5rem);
    font-weight: 800;
    color: #0D1B2A;
    letter-spacing: -0.02em;
    margin: 0 0 24px;
    line-height: 1.2;
  }

  .intro-paragraphs {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .story-p {
    font-size: 1.125rem;
    line-height: 1.7;
    color: #475569;
    margin: 0;
  }

  .timeline-track {
    position: relative;
    padding-top: 24px;
  }

  .timeline-line {
    position: absolute;
    top: 44px;
    left: 0;
    right: 0;
    height: 3px;
    background: #E2E8F0;
    z-index: 1;
  }

  .milestones-grid {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
  }

  .milestone-card {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .milestone-badge {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .year {
    font-size: 1.5rem;
    font-weight: 800;
    color: #0D1B2A;
    letter-spacing: -0.02em;
  }

  .dot {
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: #FFFFFF;
    border: 4px solid #E63946;
    box-shadow: 0 0 0 4px rgba(230, 57, 70, 0.15);
  }

  .milestone-body {
    background: #F8FAFC;
    border: 1px solid #E2E8F0;
    border-radius: 12px;
    padding: 24px 20px;
    height: 100%;
    box-sizing: border-box;
    transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .milestone-body:hover {
    transform: translateY(-3px);
    border-color: #CBD5E1;
    box-shadow: 0 8px 24px rgba(13, 27, 42, 0.06);
    background: #FFFFFF;
  }

  .milestone-title {
    font-size: 1.125rem;
    font-weight: 700;
    color: #0D1B2A;
    margin: 0 0 10px;
    line-height: 1.35;
  }

  .milestone-desc {
    font-size: 0.9375rem;
    line-height: 1.55;
    color: #64748B;
    margin: 0;
  }

  @media (max-width: 900px) {
    .milestones-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 32px;
    }
    .timeline-line {
      display: none;
    }
  }

  @media (max-width: 560px) {
    .milestones-grid {
      grid-template-columns: 1fr;
    }
    .timeline-section {
      padding: 56px 16px;
    }
  }
</style>
