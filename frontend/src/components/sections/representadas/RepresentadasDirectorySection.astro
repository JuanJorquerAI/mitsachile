---
import type { RepresentadasDirectoryData } from '../../../lib/api/types';

interface Props {
  directory: RepresentadasDirectoryData[];
}

const { directory = [] } = Astro.props;
---

<section class="representadas-directory-section" id="directorio-marcas" aria-labelledby="directory-heading">
  <div class="dir-container">
    <div class="dir-header">
      <span class="dir-badge">Directorio Global de Fabricantes</span>
      <h2 id="directory-heading" class="dir-title">Marcas Especializadas Complementarias</h2>
      <p class="dir-desc">
        Sistemas de bombeo, instrumentación, desalinización, válvulas y trituración representados por MITSA para requerimientos específicos de la industria.
      </p>
    </div>

    <!-- Grid de Directorio -->
    <div class="dir-grid">
      {directory.map((item) => (
        <div class="dir-card">
          <div class="dir-top">
            <h3 class="dir-name">{item.name}</h3>
            <span class="dir-country">📍 {item.country}</span>
          </div>
          <div class="dir-cat-badge">{item.category}</div>
          <p class="dir-card-desc">{item.description}</p>
          <a href={`/contacto/?tipo=repuestos&marca=${encodeURIComponent(item.name)}`} class="dir-link">
            Cotizar repuesto o equipo <span aria-hidden="true">→</span>
          </a>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .representadas-directory-section {
    background: #F1F5F9;
    padding: 88px 24px;
    border-bottom: 1px solid #E2E8F0;
  }

  .dir-container {
    max-width: 1200px;
    margin: 0 auto;
  }

  .dir-header {
    text-align: center;
    max-width: 760px;
    margin: 0 auto 56px;
  }

  .dir-badge {
    font-family: monospace;
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #0D1B2A;
    background: rgba(13, 27, 42, 0.08);
    padding: 6px 14px;
    border-radius: 999px;
    display: inline-block;
    margin-bottom: 16px;
  }

  .dir-title {
    font-size: clamp(1.875rem, 3vw, 2.375rem);
    font-weight: 800;
    color: #0D1B2A;
    letter-spacing: -0.025em;
    margin: 0 0 16px;
  }

  .dir-desc {
    font-size: 1.0625rem;
    line-height: 1.6;
    color: #64748B;
    margin: 0;
  }

  .dir-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
  }

  .dir-card {
    background: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 16px;
    padding: 24px;
    display: flex;
    flex-direction: column;
    box-shadow: 0 2px 10px rgba(13, 27, 42, 0.02);
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
  }

  .dir-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 10px 24px rgba(13, 27, 42, 0.06);
    border-color: #CBD5E1;
  }

  .dir-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 8px;
    gap: 8px;
  }

  .dir-name {
    font-size: 1.125rem;
    font-weight: 700;
    color: #0D1B2A;
    margin: 0;
    line-height: 1.3;
  }

  .dir-country {
    font-size: 0.75rem;
    font-weight: 600;
    color: #64748B;
    white-space: nowrap;
  }

  .dir-cat-badge {
    font-family: monospace;
    font-size: 0.6875rem;
    font-weight: 700;
    color: #E63946;
    background: rgba(230, 57, 70, 0.06);
    padding: 3px 8px;
    border-radius: 4px;
    align-self: flex-start;
    margin-bottom: 12px;
  }

  .dir-card-desc {
    font-size: 0.8125rem;
    line-height: 1.55;
    color: #475569;
    margin: 0 0 20px;
    flex-grow: 1;
  }

  .dir-link {
    font-size: 0.8125rem;
    font-weight: 700;
    color: #0D1B2A;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    transition: color 0.15s ease, transform 0.15s ease;
  }

  .dir-link:hover {
    color: #E63946;
    transform: translateX(3px);
  }

  @media (max-width: 1024px) {
    .dir-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 600px) {
    .dir-grid {
      grid-template-columns: 1fr;
    }
    .representadas-directory-section {
      padding: 56px 16px;
    }
  }
</style>
