---
import type { RepresentadasHeroData, RepresentadasMetricData } from '../../../lib/api/types';

interface Props {
  hero: RepresentadasHeroData;
  metrics: RepresentadasMetricData[];
}

const { hero, metrics = [] } = Astro.props;
const {
  title = "Marcas líderes mundiales representadas en Chile y la región.",
  description = "Ingeniería de aplicación directa con los fabricantes, repuestos originales y certificación oficial de fábrica para sistemas marinos e industriales.",
  image = "/images/hero-1-8a9d042f.jpg",
  primary_button = { label: "Ver representadas", url: "#marcas-principales" },
  secondary_button = { label: "Solicitar repuestos", url: "/contacto/?tipo=repuestos" }
} = hero || {};
---

<section class="representadas-hero-section" aria-labelledby="representadas-hero-heading">
  <div class="hero-container">
    <div class="hero-grid">
      <!-- Columna Texto -->
      <div class="hero-content">
        <div class="hero-badge-wrap">
          <span class="badge-line" aria-hidden="true"></span>
          <span class="badge-label">Representación Oficial Exclusiva</span>
        </div>
        <h1 id="representadas-hero-heading" class="hero-title">{title}</h1>
        <p class="hero-desc">{description}</p>

        <div class="hero-actions">
          <a href={primary_button.url} class="btn-primary">
            {primary_button.label}
            <span aria-hidden="true">↓</span>
          </a>
          <a href={secondary_button.url} class="btn-secondary">
            {secondary_button.label}
            <span aria-hidden="true">→</span>
          </a>
        </div>

        <!-- Métricas de Respaldo -->
        <div class="metrics-grid">
          {metrics.map((m) => (
            <div class="metric-item">
              <span class="metric-num">{m.num}</span>
              <span class="metric-label">{m.label}</span>
            </div>
          ))}
        </div>
      </div>

      <!-- Columna Imagen Hero -->
      <div class="hero-image-wrap">
        <img
          src={image}
          alt="Alianzas tecnológicas y marcas internacionales representadas por MITSA en Chile y Latinoamérica"
          width="640"
          height="480"
          loading="eager"
          fetchpriority="high"
          decoding="async"
          class="hero-img"
        />
        <div class="hero-image-overlay">
          <span class="overlay-badge">✓ Certificación de Fábrica</span>
          <span class="overlay-text">Garantía, comisionamiento y respaldo técnico directo de los fabricantes.</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .representadas-hero-section {
    background: #0D1B2A;
    color: #F8F6F0;
    padding: 80px 24px 88px;
    border-bottom: 1px solid rgba(248, 246, 240, 0.08);
  }

  .hero-container {
    max-width: 1200px;
    margin: 0 auto;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 48px;
    align-items: center;
  }

  .hero-content {
    display: flex;
    flex-direction: column;
  }

  .hero-badge-wrap {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 20px;
  }

  .badge-line {
    width: 32px;
    height: 2px;
    background: #E63946;
  }

  .badge-label {
    font-family: monospace;
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #E0E1DD;
  }

  .hero-title {
    font-size: clamp(2.25rem, 4vw, 3.25rem);
    font-weight: 800;
    line-height: 1.14;
    letter-spacing: -0.03em;
    color: #FFFFFF;
    margin: 0 0 20px;
  }

  .hero-desc {
    font-size: 1.125rem;
    line-height: 1.6;
    color: #CBD5E1;
    margin: 0 0 32px;
    max-width: 580px;
  }

  .hero-actions {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
    margin-bottom: 40px;
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #E63946;
    color: #FFFFFF;
    text-decoration: none;
    padding: 12px 24px;
    border-radius: 8px;
    font-weight: 700;
    font-size: 0.9375rem;
    min-height: 48px;
    transition: background 0.2s ease, transform 0.15s ease;
  }

  .btn-primary:hover {
    background: #D62839;
    transform: translateY(-2px);
  }

  .btn-secondary {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(255, 255, 255, 0.08);
    color: #F8F6F0;
    border: 1px solid rgba(255, 255, 255, 0.2);
    text-decoration: none;
    padding: 12px 24px;
    border-radius: 8px;
    font-weight: 600;
    font-size: 0.9375rem;
    min-height: 48px;
    transition: all 0.2s ease;
  }

  .btn-secondary:hover {
    background: rgba(255, 255, 255, 0.16);
    border-color: rgba(255, 255, 255, 0.4);
    transform: translateY(-2px);
  }

  .metrics-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    padding-top: 24px;
  }

  .metric-item {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .metric-num {
    font-size: 1.75rem;
    font-weight: 800;
    color: #E63946;
    line-height: 1;
  }

  .metric-label {
    font-size: 0.75rem;
    color: #94A3B8;
    line-height: 1.35;
  }

  .hero-image-wrap {
    position: relative;
    border-radius: 20px;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.12);
    box-shadow: 0 20px 48px rgba(0, 0, 0, 0.4);
  }

  .hero-img {
    width: 100%;
    height: 420px;
    object-fit: cover;
    display: block;
  }

  .hero-image-overlay {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 24px;
    background: linear-gradient(0deg, rgba(13, 27, 42, 0.95) 0%, rgba(13, 27, 42, 0.6) 60%, transparent 100%);
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .overlay-badge {
    font-size: 0.75rem;
    font-weight: 700;
    color: #38BDF8;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .overlay-text {
    font-size: 0.875rem;
    color: #E2E8F0;
    line-height: 1.4;
  }

  @media (max-width: 900px) {
    .hero-grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }
    .metrics-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 600px) {
    .representadas-hero-section {
      padding: 56px 16px;
    }
    .metrics-grid {
      grid-template-columns: 1fr;
    }
    .hero-actions {
      flex-direction: column;
    }
    .btn-primary, .btn-secondary {
      width: 100%;
      justify-content: center;
    }
  }
</style>
